rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'S0c4ZBH285duqGh0U5gA5tVVweY2'; }
    function isBootstrap() {
      return signedIn() && request.auth.uid in [
        'S0c4ZBH285duqGh0U5gA5tVVweY2',
        '69XsPeLgc9hlUH6UMgZMUxMv9up2'
      ];
    }
    function isMember() {
      return isBootstrap() || (signedIn() && exists(/databases/$(database)/documents/shoppingLists/family/members/$(request.auth.uid)));
    }
    match /shoppingLists/family {
      allow read, write: if isMember();
      // v1.0 ürünleri aynen burada kalır.
      match /items/{itemId} {
        allow read, write: if isMember();
      }
      // Üyelik yetkisini yalnızca yönetici değiştirebilir.
      match /members/{uid} {
        allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
        allow list: if isOwner();
        allow create, update, delete: if isOwner();
      }
      // AlGel v2.3 reminders; publish rules separately in Firebase Console.
      match /reminders/{reminderId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid in ['S0c4ZBH285duqGh0U5gA5tVVweY2','69XsPeLgc9hlUH6UMgZMUxMv9up2']
          && request.resource.data.toUid != request.auth.uid
          && request.resource.data.type == 'request'
          && request.resource.data.status == 'requested'
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200;
        allow update: if isMember()
          && resource.data.toUid == request.auth.uid
          && resource.data.status == 'requested'
          && request.resource.data.status == 'ready'
          && request.resource.data.readyBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','readyBy','readyAt','updatedAt']);
        allow delete: if false;
      }
      // Ek listeler ve bu listelerin ürünleri.
      match /listMeta/{listId} {
        allow read, create, update, delete: if isMember();
        match /items/{itemId} {
          allow read, write: if isMember();
        }
      }
    }
  }
}
