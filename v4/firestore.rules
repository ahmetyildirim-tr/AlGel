rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function auth(){return request.auth != null;}
  function self(uid){return auth() && request.auth.uid == uid;}
  function verified(){return auth() && request.auth.token.email_verified == true;}
  function member(f){return auth() && exists(/databases/$(database)/documents/families/$(f)/members/$(request.auth.uid));}
  function admin(f){return member(f) && get(/databases/$(database)/documents/families/$(f)/members/$(request.auth.uid)).data.role == 'admin';}
  function inviteBefore(i){return get(/databases/$(database)/documents/invites/$(i));}
  function inviteAfter(i){return getAfter(/databases/$(database)/documents/invites/$(i));}
  function validRedeem(f,uid,i){
   return verified() && self(uid) && i is string
    && exists(/databases/$(database)/documents/invites/$(i))
    && inviteBefore(i).data.familyId == f
    && inviteBefore(i).data.email == request.auth.token.email
    && inviteBefore(i).data.status == 'pending'
    && inviteBefore(i).data.expiresAt > request.time
    && inviteAfter(i).data.status == 'used'
    && inviteAfter(i).data.usedBy == uid;
  }
  match /users/{uid} {
   allow get: if self(uid) || auth();
   allow list: if false;
   allow create: if self(uid) && request.resource.data.username is string && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60 && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
   allow update: if self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','displayName','updatedAt']) && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60 && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
   allow delete: if false;
   match /families/{familyId} {
    allow read: if self(uid);
    allow create: if self(uid) && existsAfter(/databases/$(database)/documents/families/$(familyId)/members/$(uid)) && request.resource.data.role == getAfter(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data.role;
    allow update: if self(uid) && member(familyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
    allow delete: if self(uid) || (admin(familyId) && !existsAfter(/databases/$(database)/documents/families/$(familyId)/members/$(uid)));
   }
  }
  match /usernames/{handle} {
   allow get: if auth();
   allow list: if false;
   allow create: if auth() && handle.matches('^[a-z0-9_]{3,24}$') && request.resource.data.uid == request.auth.uid && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == handle;
   allow delete: if auth() && resource.data.uid == request.auth.uid;
   allow update: if false;
  }
  match /families/{familyId} {
   allow get: if member(familyId) || (verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/families/$(familyId)));
   allow list: if false;
   allow create: if verified() && request.resource.data.createdBy == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() <= 60 && request.resource.data.status == 'active' && getAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
   allow update: if admin(familyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 60;
   allow delete: if false;
   match /members/{uid} {
    allow get: if self(uid) || member(familyId);
    allow list: if member(familyId);
    allow create: if (verified() && self(uid) && request.resource.data.role == 'admin' && getAfter(/databases/$(database)/documents/families/$(familyId)).data.createdBy == uid && !exists(/databases/$(database)/documents/families/$(familyId)))
      || (request.resource.data.role == 'member' && validRedeem(familyId,uid,request.resource.data.inviteId));
    allow update: if false;
    allow delete: if admin(familyId) && uid != request.auth.uid && !existsAfter(/databases/$(database)/documents/users/$(uid)/families/$(familyId));
   }
   match /lists/{listId} {
    allow read: if member(familyId);
    allow create: if member(familyId) && request.resource.data.name is string && request.resource.data.name.size() <= 60 && request.resource.data.createdBy == request.auth.uid;
    allow update,delete: if member(familyId);
    match /items/{itemId} {
     allow read: if member(familyId);
     allow create: if member(familyId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() <= 100;
     allow update,delete: if member(familyId);
    }
   }
   match /reminders/{reminderId} {
    allow read: if member(familyId);
    allow create: if member(familyId)
      && request.resource.data.fromUid == request.auth.uid
      && request.resource.data.toUid != request.auth.uid
      && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.resource.data.toUid))
      && request.resource.data.status == 'requested'
      && request.resource.data.note is string && request.resource.data.note.size() <= 200;
    allow update: if member(familyId)
      && resource.data.toUid == request.auth.uid
      && resource.data.status == 'requested'
      && request.resource.data.status == 'ready'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
    allow delete: if false;
   }
   match /catalog/{productId} {
    allow read: if member(familyId);
    allow create: if member(familyId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.name is string && request.resource.data.name.size() <= 100;
    allow update,delete: if member(familyId);
   }
  }
  match /invites/{inviteId} {
   allow get: if admin(resource.data.familyId) || (verified() && resource.data.email == request.auth.token.email);
   allow list: if false;
   allow create: if verified() && admin(request.resource.data.familyId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.email is string && request.resource.data.expiresAt <= request.time + duration.value(48,'h') && request.resource.data.expiresAt > request.time;
   allow update: if verified() && resource.data.status == 'pending' && resource.data.expiresAt > request.time && resource.data.email == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedBy','usedAt']) && request.resource.data.status == 'used' && request.resource.data.usedBy == request.auth.uid && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.inviteId == inviteId;
   allow delete: if false;
  }
 }
}